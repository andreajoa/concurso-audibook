{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/files/apostila-autores-ibam-santos-2026.pdf",
      "destination": "https://sala-de-estudos-margareth.floot.app/_cdn/static/25c38207-6b86-46f5-b237-dc00211054e7-apostila-autores-ibam-santos-2026.pdf"
    },
    {
      "source": "/files/como-desarmar-as-armadilhas-da-ibam.mp3",
      "destination": "https://sala-de-estudos-margareth.floot.app/_cdn/static/d6fc2120-266a-4517-809a-89ff73d12d2f-Como_desarmar_as_armadilhas_da_IBAM_web.mp3"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/files/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
